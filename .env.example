# =============================================================================
# TrialGuard AI — environment configuration (copy to .env)
# SYNTHETIC DATA ONLY. Never commit a populated .env.
# =============================================================================

# ---- Lyzr ---------------------------------------------------------------------
# mock = offline deterministic simulators (clearly labelled, never presented as Lyzr)
# live = real Lyzr Agent API (requires the variables below)
LYZR_MODE=mock
LYZR_API_KEY=
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai
LYZR_ENVIRONMENT_ID=
LYZR_PROTOCOL_AGENT_ID=
LYZR_PATIENT_AGENT_ID=
LYZR_SAFETY_AGENT_ID=
LYZR_AUDIT_AGENT_ID=
# Emit PHI-free execution telemetry for Lyzr AIMS export
LYZR_AIMS_ENABLED=false
LYZR_TIMEOUT_MS=60000
LYZR_MAX_RETRIES=3
# Used only by `pnpm --filter @trialguard/agents provision`
LYZR_MODEL_PROVIDER=OpenAI
LYZR_MODEL=gpt-4o-mini
LYZR_LLM_CREDENTIAL_ID=lyzr_openai

# ---- Backend ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://trialguard:trialguard@localhost:5432/trialguard
# Leave REDIS_URL empty (or QUEUE_MODE=inline) to run jobs in-process without Redis
REDIS_URL=redis://localhost:6379
QUEUE_MODE=
RUN_WORKERS_IN_API=false
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_SECONDS=28800
# 32-byte key (hex or base64) for the PHI vault + encrypted document storage.
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=300
LOG_LEVEL=info

# ---- Demo ---------------------------------------------------------------------
DEMO_MODE=true
# Password for the seeded demo accounts (admin/coordinator/reviewer/auditor@trialguard.demo)
DEMO_USER_PASSWORD=TrialGuard!Demo2026
# Optional fixed screening date (the synthetic scenarios are dated 2026-09-23)
SCREENING_DATE_OVERRIDE=

# ---- Frontend -----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
