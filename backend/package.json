{
  "name": "@trialguard/backend",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "author": "Priyansh Sen",
  "private": true,
  "description": "TrialGuard AI API, deterministic rule engine, PHI protection, audit and queue workers",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm build && node dist/main.js",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "seed": "node dist/scripts/seed.js",
    "demo": "node dist/scripts/demo.js",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force --skip-seed"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "~6.16.2",
    "@trialguard/agents": "workspace:*",
    "bullmq": "^5.58.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "multer": "^2.0.2",
    "pdf-parse": "1.1.1",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.2",
    "prisma": "~6.16.2",
    "typescript": "^5.6.3"
  }
}
